<?xml version="1.0" encoding="utf-8"?>
<!--
  主界面
  =======
  结构遵循 Material 3：小顶栏 + 可滚动内容。

  四种状态互斥显示，全部在同一棵视图树里，靠可见性切换：
    空        emptyBox    —— 引导用户完成第一步
    加载      loadingBox  —— 骨架屏，不用空白页
    错误      errorBox    —— 说明问题 + 给出恢复动作
    结果      resultBox   —— 预览播放器 / 标题 / 分 P / 按画质列举的下载行

  顶层是 FrameLayout 而不是 LinearLayout：它是 Snackbar 的悬浮锚点，
  需要叠在内容之上，而不是把内容挤开。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/m3_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ==================== 顶栏 ==================== -->
        <!-- 高度 64dp，顶部 padding 由代码按状态栏 inset 补齐 -->

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/top_app_bar_height"
            android:background="@color/m3_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_lg"
            android:paddingEnd="@dimen/space_xs">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/title_main"
                android:textAppearance="@style/Text.TitleLarge" />

            <ImageButton
                android:id="@+id/btnSettings"
                style="@style/Widget.IconButton"
                android:contentDescription="@string/cd_settings"
                android:src="@drawable/ic_settings"
                android:tint="@color/m3_on_surface_variant" />
        </LinearLayout>

        <!-- ==================== 内容 ==================== -->

        <ScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="104dp"
            android:scrollbarStyle="outsideOverlay">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_margin"
                android:paddingEnd="@dimen/screen_margin">

                <!-- == 链接输入 == -->

                <TextView
                    android:id="@+id/labelUrl"
                    style="@style/Widget.FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_sm"
                    android:labelFor="@id/inputUrl"
                    android:text="@string/label_url" />

                <!-- 字段与尾部图标按钮叠放，按钮 48dp 触控区 -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <EditText
                        android:id="@+id/inputUrl"
                        style="@style/Widget.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_url"
                        android:imeOptions="actionSearch"
                        android:importantForAutofill="no"
                        android:inputType="textUri"
                        android:paddingEnd="56dp"
                        android:selectAllOnFocus="false"
                        tools:ignore="TextViewEdits" />

                    <!-- 一钮两用：输入框为空时是「粘贴」，有内容时变「清空」。
                         图标与 contentDescription 由 MainActivity 随文本切换 -->
                    <ImageButton
                        android:id="@+id/btnPaste"
                        style="@style/Widget.IconButton"
                        android:layout_gravity="end|center_vertical"
                        android:contentDescription="@string/cd_paste"
                        android:src="@drawable/ic_paste"
                        android:tint="@color/m3_on_surface_variant" />
                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/helper_url"
                    android:textAppearance="@style/Text.BodySmall" />

                <Button
                    android:id="@+id/btnParse"
                    style="@style/Widget.Button.Filled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:text="@string/action_parse" />

                <!-- == 错误：问题 + 恢复动作 == -->

                <LinearLayout
                    android:id="@+id/errorBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/content_gap"
                    android:background="@drawable/bg_error_banner"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/card_padding"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="@dimen/icon_size"
                        android:layout_height="@dimen/icon_size"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_error"
                        android:tint="@color/m3_on_error_container" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/errorTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/Text.TitleSmall"
                            android:textColor="@color/m3_on_error_container" />

                        <TextView
                            android:id="@+id/errorFix"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/Text.BodySmall"
                            android:textColor="@color/m3_on_error_container" />

                        <!-- 原始错误信息：出现问题时用户能据此反馈，不必去翻日志 -->
                        <TextView
                            android:id="@+id/errorDetail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:textAppearance="@style/Text.Code"
                            android:textColor="@color/m3_on_error_container"
                            android:visibility="gone"
                            tools:text="code=-403 请求被拒绝"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnRetry"
                        style="@style/Widget.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_sm"
                        android:drawableStart="@drawable/ic_refresh"
                        android:drawablePadding="@dimen/space_sm"
                        android:drawableTint="@color/state_button_outlined_text"
                        android:text="@string/action_retry" />
                </LinearLayout>

                <!-- == 空状态 == -->

                <LinearLayout
                    android:id="@+id/emptyBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3xl"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:background="@drawable/bg_empty_icon">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_search"
                            android:tint="@color/m3_on_secondary_container" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xl"
                        android:gravity="center"
                        android:text="@string/empty_title"
                        android:textAppearance="@style/Text.HeadlineSmall" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:gravity="center"
                        android:text="@string/empty_body"
                        android:textAppearance="@style/Text.BodyMedium" />

                    <!-- 两条能力提示，各带图标，不靠颜色区分 -->
                    <LinearLayout
                        style="@style/Widget.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/content_gap"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="@dimen/icon_size_sm"
                                android:layout_height="@dimen/icon_size_sm"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_link"
                                android:tint="@color/m3_on_surface_variant" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_md"
                                android:layout_weight="1"
                                android:text="@string/empty_hint_link"
                                android:textAppearance="@style/Text.BodySmall" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_md"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="@dimen/icon_size_sm"
                                android:layout_height="@dimen/icon_size_sm"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_music"
                                android:tint="@color/m3_on_surface_variant" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_md"
                                android:layout_weight="1"
                                android:text="@string/empty_hint_login"
                                android:textAppearance="@style/Text.BodySmall" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- == 加载骨架 == -->

                <LinearLayout
                    android:id="@+id/loadingBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/content_gap"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/cover_height"
                        android:background="@drawable/bg_skeleton" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="22dp"
                        android:layout_marginTop="@dimen/space_lg"
                        android:background="@drawable/bg_skeleton" />

                    <View
                        android:layout_width="180dp"
                        android:layout_height="16dp"
                        android:layout_marginTop="@dimen/space_md"
                        android:background="@drawable/bg_skeleton" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/content_gap"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ProgressBar
                            android:id="@+id/loadingSpinner"
                            style="?android:attr/progressBarStyleSmall"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:indeterminateTint="@color/m3_primary" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_md"
                            android:layout_weight="1"
                            android:text="@string/loading_title"
                            android:textAppearance="@style/Text.TitleSmall" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/loading_body"
                        android:textAppearance="@style/Text.BodySmall" />
                </LinearLayout>

                <!-- == 解析结果 == -->

                <LinearLayout
                    android:id="@+id/resultBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <!-- == 预览 == -->
                    <!--
                      封面和大播放键叠在视频之上。
                      视频就绪后封面隐藏，控制条从无到有出现 —— 一次只呈现一种状态，
                      不做"封面淡出 + 视频淡入"的交叉淡化（那是装饰，不是信息）。

                      高度初始为 cover_height，播放器就绪后由 PreviewController
                      按视频实际比例调整（并设上限，避免竖屏视频撑满整屏）。
                    -->

                    <FrameLayout
                        android:id="@+id/previewBox"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/cover_height"
                        android:layout_marginTop="@dimen/content_gap"
                        android:background="@drawable/bg_preview_frame"
                        android:clipToOutline="true">

                        <!--
                          这里必须是 SurfaceView 而不是 VideoView：
                          播放由 PreviewController 持有 MediaPlayer 来做，
                          为的是能通过 setDataSource(Context, Uri, Map) 传 Referer
                          —— 不带 Referer，B 站 CDN 直接返回 403。

                          而且 SurfaceView 必须常驻可见：Surface 只在视图可见时
                          才存在，而 setDisplay() 需要一个有效的 Surface。
                          "还没在播"由叠在上面的封面来表达，不靠隐藏 Surface。
                        -->
                        <SurfaceView
                            android:id="@+id/videoView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center" />

                        <ImageView
                            android:id="@+id/ivCover"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop" />

                        <!-- 大播放键：封面上唯一的主要动作 -->
                        <ImageButton
                            android:id="@+id/btnPlay"
                            style="@style/Widget.PlayButton"
                            android:layout_gravity="center" />

                        <ProgressBar
                            android:id="@+id/previewLoading"
                            style="?android:attr/progressBarStyle"
                            android:layout_width="@dimen/icon_size"
                            android:layout_height="@dimen/icon_size"
                            android:layout_gravity="center"
                            android:indeterminateTint="@color/m3_primary"
                            android:visibility="gone" />
                    </FrameLayout>

                    <!-- 播放控制条：视频准备好之后才出现。
                         进度条可拖动 —— 预览要能跳到任意位置看。 -->
                    <LinearLayout
                        android:id="@+id/previewBar"
                        style="@style/Widget.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingEnd="@dimen/card_padding"
                        android:paddingStart="@dimen/space_xs"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <ImageButton
                            android:id="@+id/btnPlayPause"
                            style="@style/Widget.IconButton"
                            android:contentDescription="@string/cd_pause"
                            android:src="@drawable/ic_pause"
                            android:tint="@color/m3_primary" />

                        <SeekBar
                            android:id="@+id/seekPreview"
                            style="@style/Widget.SeekBar"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/touch_min"
                            android:layout_marginEnd="@dimen/space_md"
                            android:layout_marginStart="@dimen/space_sm"
                            android:layout_weight="1"
                            android:contentDescription="@string/cd_preview_seek"
                            android:max="1000" />

                        <TextView
                            android:id="@+id/tvPreviewTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:textAppearance="@style/Text.LabelMedium"
                            android:textColor="@color/m3_on_surface_variant"
                            tools:text="01:24 / 13:05" />
                    </LinearLayout>

                    <!-- 预览失败时替代控制条出现 -->
                    <LinearLayout
                        android:id="@+id/previewError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <ImageView
                            android:layout_width="@dimen/icon_size_sm"
                            android:layout_height="@dimen/icon_size_sm"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_error"
                            android:tint="@color/m3_error" />

                        <TextView
                            android:id="@+id/tvPreviewError"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_md"
                            android:layout_weight="1"
                            android:textAppearance="@style/Text.BodySmall"
                            tools:text="预览加载失败，仍可直接下载" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_lg"
                        android:textAppearance="@style/Text.TitleLarge" />

                    <TextView
                        android:id="@+id/tvMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:textAppearance="@style/Text.BodyMedium" />

                    <!-- 仅在「未登录导致画质受限」时出现：说明原因，并直接给出动作 -->
                    <LinearLayout
                        android:id="@+id/qualityHintBox"
                        style="@style/Widget.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_lg"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingEnd="@dimen/space_sm"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <ImageView
                            android:layout_width="@dimen/icon_size_sm"
                            android:layout_height="@dimen/icon_size_sm"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_info"
                            android:tint="@color/m3_primary" />

                        <TextView
                            android:id="@+id/tvQualityHint"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_md"
                            android:layout_weight="1"
                            android:textAppearance="@style/Text.BodySmall" />

                        <!-- 这是「建议」而不是「恢复」动作，用色调按钮表达中等强调度 -->
                        <Button
                            android:id="@+id/btnQualityHintAction"
                            style="@style/Widget.Button.Tonal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:text="@string/action_open_settings" />
                    </LinearLayout>

                    <!-- 分 P 选择 -->

                    <TextView
                        android:id="@+id/tvPartsLabel"
                        style="@style/Widget.SectionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/section_gap"
                        android:text="@string/section_parts" />

                    <ListView
                        android:id="@+id/listParts"
                        style="@style/Widget.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/title_gap"
                        android:divider="@null"
                        android:dividerHeight="0dp"
                        android:maxHeight="@dimen/parts_list_max_height"
                        android:nestedScrollingEnabled="true"
                        android:padding="@dimen/space_sm"
                        android:scrollbarStyle="outsideOverlay" />

                    <!-- 下载：每个可用画质一行，行尾一个下载按钮 -->

                    <TextView
                        android:id="@+id/tvDownloadLabel"
                        style="@style/Widget.SectionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/section_gap"
                        android:text="@string/section_download" />

                    <!--
                      行由代码生成：可用档位的数量和名称都来自接口，
                      写死在布局里会跟着接口变而变错。
                      最后一行固定是「仅音频」。
                    -->
                    <LinearLayout
                        android:id="@+id/listDownloads"
                        style="@style/Widget.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/title_gap"
                        android:orientation="vertical"
                        android:padding="@dimen/space_sm" />

                    <!-- 下载完成后指出文件在哪，否则用户只能去文件管理器里翻 -->
                    <TextView
                        android:id="@+id/tvSavedTo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:drawableStart="@drawable/ic_folder"
                        android:drawablePadding="@dimen/space_sm"
                        android:drawableTint="@color/m3_on_surface_variant"
                        android:textAppearance="@style/Text.BodySmall"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
