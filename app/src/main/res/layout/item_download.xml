<?xml version="1.0" encoding="utf-8"?>
<!--
  一条下载目标（一个画质，或「仅音频」）
  ======================================
  整行都可点，不只是行尾那个按钮。

  上一版「仅音频」开关的教训：把可点区域只留给一个小控件（当时开关本体
  只有 47x27dp），周围看着像是一起的空间其实是死的，实测点在附近没反应。
  所以这里点击目标是整行（满宽、minHeight 48dp），行尾图标只是视觉提示，
  clickable=false 让点击穿透到行本身。

  下载中时行尾换成百分比，行下方出现细进度条 —— 进度就在用户点的地方，
  不需要滚到页面底部去看。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/rowMain"
        style="@style/Widget.DownloadRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="@dimen/space_md">

            <TextView
                android:id="@+id/tvRowLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:textAppearance="@style/Text.TitleSmall"
                tools:text="480P 标清" />

            <TextView
                android:id="@+id/tvRowMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:duplicateParentState="true"
                android:textAppearance="@style/Text.BodySmall"
                tools:text="852×480 · H.264" />
        </LinearLayout>

        <!-- 视觉上的下载提示。不接收点击，让整行来处理 -->
        <ImageView
            android:id="@+id/ivRowIcon"
            android:layout_width="@dimen/icon_size"
            android:layout_height="@dimen/icon_size"
            android:clickable="false"
            android:contentDescription="@null"
            android:duplicateParentState="true"
            android:focusable="false"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_download"
            android:tint="@color/state_row_icon" />

        <TextView
            android:id="@+id/tvRowPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textAppearance="@style/Text.LabelMedium"
            android:textColor="@color/m3_primary"
            android:visibility="gone"
            tools:text="42%"
            tools:visibility="visible" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pbRow"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/progress_height"
        android:layout_marginEnd="@dimen/space_sm"
        android:layout_marginStart="@dimen/space_sm"
        android:layout_marginTop="@dimen/space_sm"
        android:contentDescription="@string/cd_progress"
        android:max="100"
        android:progressDrawable="@drawable/progress_download"
        android:visibility="gone"
        tools:visibility="gone" />
</LinearLayout>
