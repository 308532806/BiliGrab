<?xml version="1.0" encoding="utf-8"?>
<!--
  分 P 列表项 —— Hyper-Neumorphic
  ===============================
  这一行**不做成卡片**：它本来就位于一张卡片内部（listParts 是 Widget.Card），
  卡片套卡片会同时破坏厚度语义和层级感。所以行本身是平的（Widget.ListItem）。
  （ux: "卡片里再叠卡片" 是明确的反模式。）

  选中状态仍然用多重编码表达，不只靠颜色（ux-guidelines #37）：
    · 序号 —— 徽标（bg_index_badge，与正文拉开一档）
    · 右侧 —— 对勾图标（ivSelected）
    · 行选中态 —— 由 Java 的 setSelected() 打在根容器上，子视图 duplicateParentState

  注意：上一版用的那组列表项状态色已随旧色板一起删除，
  现在文字色取 hyper 词汇里的固定值；选中态由对勾与徽标承担。
-->
<com.biligrab.downloader.ui.NeuLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.ListItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <!-- 子视图复制父级状态：setSelected() 不会自动向下传播，
         copy 之后标题与副标题的选中态才会真正生效 -->
    <!-- 序号徽标：只读标签，用 hyper 词汇里的徽标色，深浅模式各有一套值 -->
    <com.biligrab.downloader.ui.NeuText
        android:id="@+id/tvIndex"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_index_badge"
        android:gravity="center"
        android:textAppearance="@style/Text.LabelLarge"
        android:textColor="@color/hyper_badge_text" />

    <com.biligrab.downloader.ui.NeuLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_md"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.biligrab.downloader.ui.NeuText
            android:id="@+id/tvPartTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/Text.TitleSmall"
            android:textColor="@color/hyper_text_primary" />

        <com.biligrab.downloader.ui.NeuText
            android:id="@+id/tvPartDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:duplicateParentState="true"
            android:textAppearance="@style/Text.BodySmall"
            android:textColor="@color/hyper_text_secondary" />
    </com.biligrab.downloader.ui.NeuLayout>

    <!-- 选中标记：让状态不只靠颜色传达 -->
    <com.biligrab.downloader.ui.NeuImage
        android:id="@+id/ivSelected"
        android:layout_width="@dimen/icon_size"
        android:layout_height="@dimen/icon_size"
        android:layout_marginStart="@dimen/space_sm"
        android:contentDescription="@null"
        android:src="@drawable/ic_check"
        android:tint="@color/scheme_0_primary"
        android:visibility="invisible" />

</com.biligrab.downloader.ui.NeuLayout>
