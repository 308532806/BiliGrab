<?xml version="1.0" encoding="utf-8"?>
<!--
  分 P 列表项
  ============
  透明底 + 选中态底色，**不做成卡片** —— 它本来就位于一张卡片内部，
  卡片套卡片是 impeccable 明确列出的反模式。

  选中状态同时用三种编码表达：底色、标题色、右侧对勾图标。
  「不以颜色为唯一编码」（ux-guidelines #37）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_list_item"
    android:gravity="center_vertical"
    android:minHeight="@dimen/touch_min"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_md"
    android:paddingTop="@dimen/space_md"
    android:paddingEnd="@dimen/space_md"
    android:paddingBottom="@dimen/space_md">

    <!-- 序号：等宽数字，避免 P1 / P10 对不齐 -->
    <!-- 子视图复制父级状态：setSelected() 不会自动向下传播，
         copy 之后标题与副标题的选中态配色才会真正生效 -->
    <TextView
        android:id="@+id/tvIndex"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_index_badge"
        android:duplicateParentState="true"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:textColor="@color/m3_on_tertiary_container"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_md"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPartTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/Text.TitleSmall"
            android:textColor="@color/state_list_item_title" />

        <TextView
            android:id="@+id/tvPartDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:duplicateParentState="true"
            android:textAppearance="@style/Text.BodySmall"
            android:textColor="@color/state_list_item_meta" />
    </LinearLayout>

    <!-- 选中标记：让状态不只靠颜色传达 -->
    <ImageView
        android:id="@+id/ivSelected"
        android:layout_width="@dimen/icon_size"
        android:layout_height="@dimen/icon_size"
        android:layout_marginStart="@dimen/space_sm"
        android:contentDescription="@null"
        android:src="@drawable/ic_check"
        android:tint="@color/m3_primary"
        android:visibility="invisible" />

</LinearLayout>
