<?xml version="1.0" encoding="utf-8"?>
<!--
  新拟态自定义属性
  ================
  这些属性让新拟态可以写在 XML 与 style 里，而不是在 Java 里到处 findViewById
  再手工铺背景。

  典型用法 —— 定义一次，到处用：

      <style name="Widget.Card" parent="">
          <item name="neuStyle">convex</item>
          <item name="neuRadius">@dimen/radius_card</item>
          <item name="neuElevation">@dimen/elev_card</item>
      </style>

  配套的 View 类在 com.biligrab.downloader.ui 下（NeuLayout / NeuFrame /
  NeuText / NeuButton / NeuImage / NeuImageButton / NeuEdit），
  它们构造时读取这些属性并交给 NeumorphicSurface。
-->
<resources>

    <declare-styleable name="Neumorphic">
        <!-- 凸起（默认）或凹陷。凹陷画的是内阴影，方向与凸起相反 -->
        <attr name="neuStyle" format="enum">
            <enum name="convex" value="0" />
            <enum name="concave" value="1" />
            <enum name="none" value="2" />
        </attr>

        <!-- 圆角。取值见 dimens.xml 的 radius_* 一组 -->
        <attr name="neuRadius" format="dimension" />

        <!-- 浮雕高度。同时决定模糊半径与阴影偏移，取值见 dimens.xml 的 elev_* 一组 -->
        <attr name="neuElevation" format="dimension" />

        <!-- 覆盖底色。留空时用主题的 neumBase（页面背景色）——
             新拟态的默认约定是卡片与页面同色，靠阴影表达层级 -->
        <attr name="neuFill" format="color" />

        <!-- 装上无涟漪点击（缩放 + 浮雕形变 + 触觉反馈）。
             真的点击行为仍需在 Java 里设置。 -->
        <attr name="neuPress" format="boolean" />

        <!--
          按钮在界面里的分量。决定文字色，以及（配合 neuElevation）浮雕的强弱。

              filled    主操作。每屏只应该有一个 —— 用主色文字。
              tonal     次级主色操作。也是主色文字，但浮雕更浅，视觉权重低于 filled。
              outlined  中性操作。用正文色，与主色无关。取消、删除这类都属于它。

          为什么必须在 Java 里解析而不是写死在 style 的 textColor 里：
          主题色是运行期设置，XML 只能取编译期的静态值。原来
          Widget.Button.Filled 写死 @color/scheme_0_primary（樱花粉，
          第一套主题色的快照），用户换成深海蓝之后所有主按钮仍是粉字，
          而按钮底色已经跟着变了 —— 粉字压在蓝底上。
        -->
        <attr name="neuRole" format="enum">
            <enum name="none" value="0" />
            <enum name="filled" value="1" />
            <enum name="tonal" value="2" />
            <enum name="outlined" value="3" />
        </attr>

        <!--
          这里曾经还声明过 neuStroke（主色描边）与 neuGlassFlat（玻璃面描边开关），
          已删除：在 attrs 里声明不等于生效，而 NeumAttr 从头到尾没有读过这两个 ——
          在布局或 style 里写了它们不会有任何效果。

          "静默无效的属性"比"没有这个属性"更糟：写的人会以为自己设置了聚焦描边，
          然后花时间去查为什么没出现。要么在 NeumAttr 里实现，要么就别声明。
          目前两处需要描边的地方（输入框聚焦、导航高亮）都是按须在 Java 里
          直接设 drawable 的，所以走删除这一条。
        -->
    </declare-styleable>

</resources>
