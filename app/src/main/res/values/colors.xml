<?xml version="1.0" encoding="utf-8"?>
<!--
  Hyper-Neumorphic 色板 —— 浅色
  ==============================
  来源：Yang-Ya-Chao/android-design-system-skills 的 hyper-neumorphic 规范
  （见 docs/design-refs/hyper-neumorphic.md）。

  与原先的 Material 3 色板是两套体系，不要混用：
    M3 靠色角色（primary/onPrimary/surfaceContainer…）表达层级，
    新拟态靠**浮雕**表达层级 —— 背景和卡片几乎是同一个色，
    凸起与凹陷由亮面高光 + 暗面投影画出来，而不是靠色阶差。

  所以这里刻意没有 container/on-container 那一族：
  色角色少而语义明确，层级交给 NeumorphicDrawable。

  阴影两色是整个体系的地基，缺一不可：
    neum_light 左上高光 —— 模拟光源
    neum_dark  右下投影 —— 模拟厚度
  深色模式下这两色要换成各自的反向值，否则浮雕会消失（见 values-night）。
-->
<resources>

    <!-- ═══ 表面 ═══ -->
    <!-- 页面底色。卡片与它同色，靠浮雕区分，这是新拟态的核心约定 -->
    <color name="hyper_background">#F2F4F8</color>
    <color name="hyper_card">#FFFFFF</color>

    <!-- 页面渐变。浅色下极淡，只用来打破纯色的平板感 -->
    <color name="hyper_gradient_top">#EAF1FF</color>
    <color name="hyper_gradient_mid">#F5F6FB</color>
    <color name="hyper_gradient_bottom">#FFFFFF</color>

    <!--
      ═══ 文字 ═══

      这三个值按 WCAG 对比度定，不是凭手感挑的。校验见 tools/gen_palette.py。

      次要/三级文字都是相对 hyper_background（页面底色）而不是 hyper_card 定的 ——
      新拟态引擎里 neumBase() 返回的就是页面底色，卡片与页面同色，
      所以页面底色才是这两级文字实际所在的背景。按卡片色去算会算出一个偏乐观的读数。
    -->
    <color name="hyper_text_primary">#111111</color>
    <!-- 4.75:1（原先 #6F7280 只有 4.34:1，差 0.16 没到正文门槛） -->
    <color name="hyper_text_secondary">#505360</color>
    <!-- 3.16:1（原先 #B5B5C0 只有 1.85:1，连提示级的 3:1 都不到；
         深色主题的同项是 4.36:1，浅深原来是不对称的） -->
    <color name="hyper_text_tertiary">#6A6D7B</color>

    <!-- ═══ 语义色 ═══ -->
    <color name="hyper_success">#32BB78</color>
    <color name="hyper_warning">#FFB300</color>
    <color name="hyper_error">#FF5252</color>

    <!-- ═══ 描边与分隔 ═══ -->
    <color name="hyper_border">#E5E5E5</color>
    <color name="hyper_divider">#F0F0F0</color>

    <!-- 列表滚到尽头时系统浮出的拉伸光晕。用主色的中性版而不是系统默认的
         灰色，换主题色时不会突兀。 -->
    <color name="hyper_scroll_edge">#40000000</color>

    <!-- ═══ 附属面 ═══ -->
    <color name="hyper_icon_bg">#F2F4F8</color>
    <color name="hyper_badge_bg">#E8F4FF</color>
    <color name="hyper_badge_text">#007AFF</color>

    <!-- ═══ 浮雕阴影 ═══ -->
    <color name="neum_light">#FFFFFF</color>
    <color name="neum_dark">#D1D9E6</color>

    <!-- ═══ 玻璃态（第二引擎）═══
         全局只由 GlassMeshDrawable 绘制一次 mesh，
         玻璃面只做半透明叠加，让底下的光斑自然透出 -->
    <color name="glass_mesh_base">#F3EFEA</color>
    <!--
      玻璃面的叠加色。规范给的是 #2EFFFFFF（18% 白），实机偏薄：
      网格一旦有颜色，18% 的白不足以把卡片从背景里托出来。
      提到 36% 之后卡片才有"磨砂玻璃"的实体感，同时仍然透得过光斑。
    -->
    <color name="glass_tint_convex">#5CFFFFFF</color>
    <!--
      凹面的叠加压得很轻（4%）。玻璃的凹陷靠方向光表达，不靠压暗：
      凹槽通常落在不透明的容器里（例如设置面板），背后没有网格可透，
      这时候 12% 的黑会退化成一个平灰方块，完全没有深度。
    -->
    <color name="glass_tint_concave">#0A000000</color>
    <color name="glass_border_hi">#CCFFFFFF</color>
    <color name="glass_border_lo">#1F000000</color>
    <color name="glass_inner_highlight">#80FFFFFF</color>
    <color name="glass_outer_shadow">#33737D99</color>

    <!-- ═══ 遮罩 ═══ -->
    <color name="hyper_scrim">#66000000</color>
    <color name="hyper_edit_overlay">#CC1F2937</color>

    <!-- ═══ 通知栏 ═══ -->
    <color name="hyper_notification_icon">#FFFFFF</color>

</resources>
