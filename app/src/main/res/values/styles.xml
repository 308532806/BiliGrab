<?xml version="1.0" encoding="utf-8"?>
<!--
  排版与组件样式
  ================
  全部字号取自 Material 3 字阶（Display / Headline / Title / Body / Label），
  不在这里手写任意字号 —— 这是 impeccable 的 craft-floor 明确要求的：
  "obvious scale and weight steps"，以及 android.md 的 "never hand-pick sizes"。

  单位一律 sp，跟随系统字体缩放。
  浅色深色通过 @color/m3_* 自动切换（values-night/colors.xml）。

  注意：Android 样式名里的点号表示**继承**。所以 Text.TitleLarge 会被当作
  Text 的子样式，Widget.Button.Filled 会一路找 Widget.Button 和 Widget。
  这些基类必须真的存在，否则 aapt2 link 会报 "resource style/Text not found"。
-->
<resources>

    <!-- ================================================================
         命名基类
         本身不带属性，只用于承载下方带点的样式名。
         ================================================================ -->

    <style name="Text" parent="" />

    <style name="Widget" parent="" />

    <!-- 按钮公共属性。Filled / Tonal / Outlined 只覆盖底色的文字色 -->
    <style name="Widget.Button" parent="Widget">
        <item name="android:textAppearance">@style/Text.LabelLarge</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:minWidth">@dimen/button_height</item>
        <item name="android:paddingStart">@dimen/space_xl</item>
        <item name="android:paddingEnd">@dimen/space_xl</item>
        <item name="android:gravity">center</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- ================================================================
         Material 3 字阶
         ================================================================ -->

    <style name="Text.HeadlineSmall">
        <item name="android:textSize">24sp</item>
        <item name="android:lineHeight">32sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/m3_on_surface</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Title：页面标题、卡片标题、列表主标题 -->
    <style name="Text.TitleLarge">
        <item name="android:textSize">22sp</item>
        <item name="android:lineHeight">28sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/m3_on_surface</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:lineHeight">24sp</item>
        <item name="android:letterSpacing">0.009</item>
        <item name="android:textColor">@color/m3_on_surface</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.TitleSmall">
        <item name="android:textSize">14sp</item>
        <item name="android:lineHeight">20sp</item>
        <item name="android:letterSpacing">0.007</item>
        <item name="android:textColor">@color/m3_on_surface</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Body：正文。深色主题是分别设计的，不是浅色的机械反转 -->
    <style name="Text.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:lineHeight">24sp</item>
        <item name="android:letterSpacing">0.031</item>
        <item name="android:textColor">@color/m3_on_surface</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:lineHeight">22sp</item>
        <item name="android:letterSpacing">0.018</item>
        <item name="android:textColor">@color/m3_on_surface_variant</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:lineHeight">18sp</item>
        <item name="android:letterSpacing">0.033</item>
        <item name="android:textColor">@color/m3_on_surface_variant</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- 机器文本：原始错误码、接口返回这类内容。等宽在这里是语义需要，
         因为它们本身就是代码，不是为了"看起来技术感" -->
    <style name="Text.Code" parent="Text.BodySmall">
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Label：按钮、芯片、字段标签 -->
    <style name="Text.LabelLarge">
        <item name="android:textSize">14sp</item>
        <item name="android:lineHeight">20sp</item>
        <item name="android:letterSpacing">0.007</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:lineHeight">16sp</item>
        <item name="android:letterSpacing">0.042</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- ================================================================
         组件
         ================================================================ -->

    <!-- 图标按钮：触控区固定 48dp，视觉图标 24dp -->
    <style name="Widget.IconButton">
        <item name="android:layout_width">@dimen/touch_min</item>
        <item name="android:layout_height">@dimen/touch_min</item>
        <item name="android:background">@drawable/bg_icon_button</item>
        <item name="android:padding">@dimen/space_md</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- 填充按钮：主要动作，一屏只允许一个 -->
    <style name="Widget.Button.Filled">
        <item name="android:background">@drawable/bg_button_filled</item>
        <item name="android:textColor">@color/state_button_filled_text</item>
    </style>

    <!-- 色调按钮：次级动作 -->
    <style name="Widget.Button.Tonal">
        <item name="android:background">@drawable/bg_button_tonal</item>
        <item name="android:textColor">@color/state_button_tonal_text</item>
    </style>

    <!-- 描边按钮：与填充按钮并列时的次要选择 -->
    <style name="Widget.Button.Outlined">
        <item name="android:background">@drawable/bg_button_outlined</item>
        <item name="android:textColor">@color/state_button_outlined_text</item>
    </style>

    <!-- 卡片：M3 用色调表达层级，而不是投影 -->
    <style name="Widget.Card">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">@dimen/card_padding</item>
    </style>

    <!-- 列表项：保证 48dp 最小高度 -->
    <style name="Widget.ListItem">
        <item name="android:background">@drawable/bg_list_item</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:paddingStart">@dimen/space_lg</item>
        <item name="android:paddingEnd">@dimen/space_lg</item>
        <item name="android:paddingTop">@dimen/space_md</item>
        <item name="android:paddingBottom">@dimen/space_md</item>
    </style>

    <!-- 芯片：可选中的画质 / 主题筛选项。
         minHeight 用 touch_min 而不是 chip_height —— 视觉高度靠 bg_chip 的
         inset 压到 36dp，可点区域必须保持 48dp -->
    <style name="Widget.Chip">
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:textColor">@color/state_chip_text</item>
        <item name="android:textAppearance">@style/Text.LabelLarge</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:minWidth">@dimen/touch_min</item>
        <item name="android:paddingStart">@dimen/space_lg</item>
        <item name="android:paddingEnd">@dimen/space_lg</item>
        <item name="android:gravity">center</item>
        <item name="android:singleLine">true</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- 封面上的大播放键：实心主色圆 + on_primary 图标。
         不设 elevation —— 父容器开了 clipToOutline，子视图的投影会被裁掉，
         设了也是白设；主色圆本身在照片封面上已经足够突出。 -->
    <style name="Widget.PlayButton" parent="Widget">
        <item name="android:layout_width">@dimen/play_button_size</item>
        <item name="android:layout_height">@dimen/play_button_size</item>
        <item name="android:background">@drawable/bg_play_button</item>
        <item name="android:contentDescription">@string/cd_play</item>
        <item name="android:padding">@dimen/space_lg</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:src">@drawable/ic_play</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:tint">@color/m3_on_primary</item>
    </style>

    <!-- 预览进度条。
         控件本身 48dp 高（touch_min）保证能拖得动，视觉上的轨道只有 4dp：
         靠上下各 22dp 的 padding 把轨道压到中间。 -->
    <style name="Widget.SeekBar" parent="Widget">
        <item name="android:background">@null</item>
        <item name="android:maxHeight">@dimen/progress_height</item>
        <item name="android:minHeight">@dimen/progress_height</item>
        <item name="android:paddingBottom">22dp</item>
        <item name="android:paddingTop">22dp</item>
        <item name="android:progressDrawable">@drawable/progress_download</item>
        <item name="android:splitTrack">false</item>
        <item name="android:thumb">@drawable/thumb_slider</item>
    </style>

    <!-- 下载行：整行可点，不是只有行尾的按钮可点 -->
    <style name="Widget.DownloadRow" parent="@style/Widget.ListItem">
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:paddingStart">@dimen/space_sm</item>
        <item name="android:paddingEnd">@dimen/space_sm</item>
    </style>

    <!-- 文本字段：M3 filled 风格 -->
    <style name="Widget.TextField">
        <item name="android:textAppearance">@style/Text.BodyLarge</item>
        <item name="android:textColor">@color/m3_on_surface</item>
        <item name="android:textColorHint">@color/m3_on_surface_variant</item>
        <item name="android:background">@drawable/bg_textfield</item>
        <item name="android:minHeight">@dimen/field_height</item>
        <item name="android:paddingStart">@dimen/space_lg</item>
        <item name="android:paddingEnd">@dimen/space_lg</item>
        <item name="android:paddingTop">@dimen/space_lg</item>
        <item name="android:paddingBottom">@dimen/space_lg</item>
        <item name="android:singleLine">true</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <!-- 字段标签：始终可见，绝不用 placeholder 当标签 -->
    <style name="Widget.FieldLabel" parent="Text.LabelMedium">
        <item name="android:textColor">@color/m3_on_surface_variant</item>
    </style>

    <!-- 分区标题 -->
    <style name="Widget.SectionTitle" parent="Text.TitleMedium">
        <item name="android:textColor">@color/m3_on_surface</item>
    </style>

</resources>
