<?xml version="1.0" encoding="utf-8"?>
<!--
  样式词汇表 —— Hyper-Neumorphic
  ==============================
  来源：docs/design-refs/hyper-neumorphic.md 的 Type.kt / Spacing.kt /
  「圆角层级」表。

  分两层：

    1. Text.*   —— 纯排版，不涉及背景。字重刻意只用三档：
                   Bold / SemiBold-Medium / Normal。
                   新拟态的背景已经足够"吵"，字重再多一层会显得脏。

    2. Widget.* —— 组件的完整外观。新拟态参数（neuStyle / neuRadius /
                   neuElevation）写在这里，布局里只要 style="@style/Widget.Card"
                   就能拿到正确的浮雕，不必在 Java 里逐个铺设。

  两条硬规则：
    · 所有组件样式都不带涟漪。parent 一律为空，避免继承到系统的波纹。
    · 圆角与浮雕必须成组使用（28/6、26/6、16/2、14/1.5），
      单改其中一个会破坏厚度的一致性。
-->
<resources>

    <!-- ==================== 排版 ==================== -->

    <style name="Text" parent="">
        <item name="android:textColor">@color/hyper_text_primary</item>
    </style>

    <!-- 36sp Bold —— 唯一用途是空态的大标题 -->
    <style name="Text.Display">
        <item name="android:textSize">36sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <!-- 32sp Bold —— 页面级大标题 -->
    <style name="Text.HeadlineSmall">
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <!--
      22sp Bold —— 顶栏标题。

      规范的字阶里没有这一档，是补的。原因：规范把 32sp headlineMedium 同时
      给了"页面大标题"和"顶栏标题"，但一个屏幕上只会有一个视觉焦点。
      顶栏和页面标题都用 32sp 时两者互相打架，而且中文 32sp 在 360dp 宽的
      屏幕上放不下 9 个字（9 × 32sp = 288dp，可用只有 312dp），必然断行。
      把顶栏降到导航层级之后，32sp 独占"页面大标题"这一档，层级才成立。
    -->
    <style name="Text.AppBar">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- 18sp SemiBold —— 卡片标题、视频标题 -->
    <style name="Text.TitleLarge">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <!-- 16sp Medium —— 次级标题 -->
    <style name="Text.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- 14sp Medium —— 行标题、按画质列举的标签 -->
    <style name="Text.TitleSmall">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- 16sp / 行高 24 —— 正文 -->
    <style name="Text.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style name="Text.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/hyper_text_secondary</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <!-- 12sp —— 帮助文字、次要说明 -->
    <style name="Text.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/hyper_text_secondary</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="Text.LabelLarge">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/hyper_text_primary</item>
    </style>

    <!-- 12sp Medium —— 元信息、徽标 -->
    <style name="Text.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/hyper_text_secondary</item>
    </style>

    <!-- 等宽 —— 版本号、原始错误信息，需要逐字对齐的场景 -->
    <style name="Text.Code">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/hyper_text_secondary</item>
    </style>

    <!-- ==================== 组件 ==================== -->

    <!-- 页面卡片：28dp / 6dp。整套界面的基本容器 -->
    <style name="Widget.Card" parent="">
        <item name="neuStyle">convex</item>
        <item name="neuRadius">@dimen/radius_card</item>
        <item name="neuElevation">@dimen/elev_card</item>
    </style>

    <!-- 凹陷卡片：用于"被挖进去"的容器，例如分段控件的底槽 -->
    <style name="Widget.Card.Concave" parent="">
        <item name="neuStyle">concave</item>
        <item name="neuRadius">@dimen/radius_card</item>
        <item name="neuElevation">@dimen/elev_field</item>
    </style>

    <!-- 图标按钮：18dp / 3dp，固定 48dp 触控区 -->
    <style name="Widget.IconButton" parent="">
        <item name="android:layout_width">@dimen/touch_min</item>
        <item name="android:layout_height">@dimen/touch_min</item>
        <item name="android:background">@null</item>
        <item name="android:padding">@dimen/space_md</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="neuStyle">convex</item>
        <item name="neuRadius">@dimen/radius_icon_button</item>
        <item name="neuElevation">@dimen/elev_icon_button</item>
        <item name="neuPress">true</item>
    </style>

    <!-- 主按钮：26dp / 6dp，高 52dp -->
    <style name="Widget.Button" parent="">
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:background">@null</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="neuStyle">convex</item>
        <item name="neuRadius">@dimen/radius_button</item>
        <item name="neuElevation">@dimen/elev_button</item>
        <item name="neuPress">true</item>
    </style>

    <!-- 主按钮的文字用主色（运行时由 MainActivity 再确认一次，覆盖默认值） -->
    <style name="Widget.Button.Filled">
        <item name="android:textColor">@color/scheme_0_primary</item>
    </style>

    <!-- 次要按钮：靠浮雕的强弱区分，不靠描边 -->
    <style name="Widget.Button.Outlined">
        <item name="android:textColor">@color/hyper_text_primary</item>
    </style>

    <style name="Widget.Button.Tonal">
        <item name="android:textColor">@color/hyper_text_primary</item>
    </style>

    <!-- 输入框：凹槽 16dp / 2dp，高 56dp -->
    <style name="Widget.TextField" parent="">
        <item name="android:layout_height">@dimen/field_height</item>
        <item name="android:background">@null</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/hyper_text_primary</item>
        <item name="android:textColorHint">@color/hyper_text_tertiary</item>
        <item name="android:paddingStart">@dimen/space_lg</item>
        <item name="android:paddingEnd">@dimen/space_lg</item>
        <item name="android:singleLine">true</item>
        <item name="neuStyle">concave</item>
        <item name="neuRadius">@dimen/radius_field</item>
        <item name="neuElevation">@dimen/elev_field</item>
    </style>

    <!-- 字段标签：小、次要、全大写的替代是"加大字距" -->
    <style name="Widget.FieldLabel" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">@color/hyper_text_secondary</item>
    </style>

    <!-- 区块标题：32dp 上方留白是本设计系统的节奏基准 -->
    <style name="Widget.SectionTitle" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textColor">@color/hyper_text_secondary</item>
    </style>

    <!-- 列表行：扁平，不带浮雕 —— 行是卡片"里面"的东西，
         在卡片上再叠一层浮雕会让厚度语义失效 -->
    <style name="Widget.ListItem" parent="">
        <item name="android:background">@null</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:paddingTop">@dimen/space_md</item>
        <item name="android:paddingBottom">@dimen/space_md</item>
    </style>

    <!-- 芯片：14dp / 3dp，可见高 32dp，触控区补到 48dp -->
    <style name="Widget.Chip" parent="">
        <item name="android:gravity">center</item>
        <item name="android:textSize">14sp</item>
        <item name="android:background">@null</item>
        <item name="android:paddingStart">@dimen/space_lg</item>
        <item name="android:paddingEnd">@dimen/space_lg</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="neuStyle">convex</item>
        <item name="neuRadius">@dimen/radius_chip</item>
        <item name="neuElevation">@dimen/elev_chip</item>
        <item name="neuPress">true</item>
    </style>

    <!-- 下载行：整行就是按钮，28dp / 6dp -->
    <style name="Widget.DownloadRow" parent="">
        <item name="android:background">@null</item>
        <item name="android:orientation">vertical</item>
        <item name="neuStyle">convex</item>
        <item name="neuRadius">@dimen/radius_card</item>
        <item name="neuElevation">@dimen/elev_card</item>
    </style>

    <!-- 封面上的大播放键：圆形，全圆角 -->
    <style name="Widget.PlayButton" parent="">
        <item name="android:layout_width">@dimen/play_button_size</item>
        <item name="android:layout_height">@dimen/play_button_size</item>
        <item name="android:background">@null</item>
        <item name="android:padding">@dimen/space_lg</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="neuStyle">convex</item>
        <item name="neuRadius">@dimen/radius_pill</item>
        <item name="neuElevation">@dimen/elev_button</item>
        <item name="neuPress">true</item>
    </style>

    <!--
      图标底板：空态那种"一块圆盘托着一个图标"的场景。

      注意不要用 @drawable 去做这块底板。新拟态的层级完全来自阴影，
      而任何和背景同色的纯色形状画上去都是看不见的 —— 必须走浮雕才有"托起来"的效果。
    -->
    <style name="Widget.IconPlate" parent="">
        <item name="neuStyle">convex</item>
        <item name="neuRadius">@dimen/radius_pill</item>
        <item name="neuElevation">@dimen/elev_card</item>
    </style>

    <!-- 进度条：新拟态版由 ui/NeumorphicSeekBar 实现，这里只给尺寸 -->
    <style name="Widget.SeekBar" parent="">
        <item name="android:layout_height">@dimen/touch_min</item>
        <item name="android:background">@null</item>
    </style>

</resources>
