<?xml version="1.0" encoding="utf-8"?>
<!--
  Hyper-Neumorphic 色板 —— 深色

  深色下新拟态最容易做废：如果把「高光」直接沿用白色、「投影」沿用浅灰，
  浮雕会整个消失（深色背景上白色高光过曝、浅灰投影看不见）。
  正确做法是把两色都往背景色里收：
    neum_light = #26282C（比背景亮一点点）
    neum_dark  = #0D0E11（比背景暗一点点）
  对比度低是**故意的** —— 浮雕靠这点微差成立，拉大就变成硬阴影了。
-->
<resources>

    <!-- ═══ 表面 ═══ -->
    <color name="hyper_background">#1A1B1E</color>
    <color name="hyper_card">#1E1E1E</color>

    <color name="hyper_gradient_top">#0D1117</color>
    <color name="hyper_gradient_mid">#12161C</color>
    <color name="hyper_gradient_bottom">#1A1E25</color>

    <!-- ═══ 文字 ═══ -->
    <color name="hyper_text_primary">#F5F5F5</color>
    <color name="hyper_text_secondary">#B3B3B3</color>
    <color name="hyper_text_tertiary">#808080</color>

    <!-- ═══ 语义色 ═══ -->
    <color name="hyper_success">#30D158</color>
    <color name="hyper_warning">#FFB74D</color>
    <color name="hyper_error">#FF8A80</color>

    <!-- ═══ 描边与分隔 ═══ -->
    <color name="hyper_border">#2D2D2D</color>
    <color name="hyper_divider">#262626</color>

    <!-- ═══ 附属面 ═══ -->
    <color name="hyper_icon_bg">#2A2A2A</color>
    <color name="hyper_badge_bg">#0A2A4A</color>
    <color name="hyper_badge_text">#0A84FF</color>

    <!-- ═══ 浮雕阴影 ═══ -->
    <color name="neum_light">#26282C</color>
    <color name="neum_dark">#0D0E11</color>

    <!-- ═══ 玻璃态 ═══ -->
    <color name="glass_mesh_base">#0F1320</color>
    <color name="glass_tint_convex">#1FFFFFFF</color>
    <color name="glass_tint_concave">#24000000</color>
    <color name="glass_border_hi">#8CFFFFFF</color>
    <color name="glass_border_lo">#1FFFFFFF</color>
    <color name="glass_inner_highlight">#73FFFFFF</color>
    <color name="glass_outer_shadow">#47000000</color>

    <!-- ═══ 遮罩 ═══ -->
    <color name="hyper_scrim">#99000000</color>
    <color name="hyper_edit_overlay">#CC0F1115</color>

    <!-- ═══ 通知栏 ═══ -->
    <color name="hyper_notification_icon">#FFFFFF</color>

</resources>
