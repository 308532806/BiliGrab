<?xml version="1.0" encoding="utf-8"?>
<!--
  下载行行尾图标的着色
  ======================
  可用时用主色（表示"这里可以点"），
  已有任务在跑时整行置灰，图标同时变淡 —— 状态要有非颜色的表达，
  所以这里只是补充，不是唯一信号（置灰的行同时也接不到点击）。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:alpha="0.38" android:color="@color/m3_on_surface" android:state_enabled="false" />
    <item android:color="@color/m3_primary" />
</selector>
