<?xml version="1.0" encoding="utf-8"?>
<!-- M3 filled 文本字段：上方圆角 + 底部 1dp 指示线 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_on_surface">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners
                        android:topLeftRadius="@dimen/shape_xs"
                        android:topRightRadius="@dimen/shape_xs" />
                    <solid android:color="@color/m3_surface_container_highest" />
                </shape>
            </item>
            <item android:gravity="bottom">
                <shape android:shape="rectangle">
                    <solid android:color="@color/m3_on_surface_variant" />
                    <size android:height="@dimen/stroke" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
