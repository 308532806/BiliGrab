<?xml version="1.0" encoding="utf-8"?>
<!--
  骨架屏占位块。
  用极低对比的中性色：骨架屏的目的是"这里将有内容"，
  对比度一高就会喧宾夺主，看起来像是真的加载出了什么东西。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/hyper_divider" />
    <corners android:radius="@dimen/radius_field" />
</shape>