<?xml version="1.0" encoding="utf-8"?>
<!--
  启动图标前景
  =============
  一个符号，不是三个符号拼在一起。

  自适应图标画布 108×108，其中 18..90 是会被遮罩裁剪的区域，
  真正保证可见的是中心约 66×66。这里所有图形都收在 23..85 之内。

  造型取自「下载」这个动作本身：箭头落进托盘。
  全填充、等宽笔画，缩到 48dp 依然读得出来 —— 描边在这么小的尺寸下会显得发虚。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 箭杆：宽 12 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M48,23 h12 v24 h-12 z" />

    <!-- 箭头：宽 40，顶点 54,69 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M34,45 L74,45 L54,69 Z" />

    <!-- 托盘：宽 52 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M28,77 h52 v8 h-52 z" />

</vector>
