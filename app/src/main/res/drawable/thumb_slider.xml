<?xml version="1.0" encoding="utf-8"?>
<!--
  滑杆手柄
  =========
  Material 3 用手柄（bar handle）而不是圆点。宽度 4dp、高度 20dp 的圆角竖条，
  和 4dp 的轨道同宽 —— 这样拖到任意位置，手柄看起来都是轨道的延续。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/shape_xs" />
    <size
        android:width="4dp"
        android:height="20dp" />
    <solid android:color="@color/m3_primary" />
</shape>
