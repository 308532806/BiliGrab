<?xml version="1.0" encoding="utf-8"?>
<!--
  芯片背景
  ========
  外面套一层 inset：控件本身占满 48dp 触控目标，
  但可见的药丸只有 36dp（上下各内缩 6dp）。

  这是 Material 3 的做法 —— 视觉尺寸和可点尺寸是两件事，
  芯片看起来紧凑，点起来仍然达标。
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetTop="@dimen/chip_inset"
    android:insetBottom="@dimen/chip_inset">
    <ripple android:color="@color/ripple_primary">
        <item>
            <shape android:shape="rectangle">
                <corners android:radius="@dimen/shape_sm" />
                <solid android:color="@color/state_chip_bg" />
                <stroke android:width="@dimen/stroke" android:color="@color/state_chip_stroke" />
            </shape>
        </item>
    </ripple>
</inset>
