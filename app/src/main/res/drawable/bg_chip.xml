<?xml version="1.0" encoding="utf-8"?>
<!-- 芯片：选中时填充 secondary_container 并收起描边 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_primary">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/shape_sm"/>
            <solid android:color="@color/state_chip_bg"/>
            <stroke android:width="@dimen/stroke" android:color="@color/state_chip_stroke"/>
        </shape>
    </item>
</ripple>
