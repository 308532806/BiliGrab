<?xml version="1.0" encoding="utf-8"?>
<!--
  主题化图标（Android 13+ 的 monochrome 层）
  ============================================
  系统取这一层的**形状**，填上从桌面壁纸派生的单色，所以这里
  只能有纯黑填充 —— 留着渐变或半透明阴影，系统会把它当成
  一个不透明的色块，做出来的主题图标会脏。

  形状与 ic_launcher_foreground 一致（下箭头 + 落点横线），但不含阴影。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#FF000000"
        android:pathData="M48,26 h12 v22 h-12 z" />
    <path
        android:fillColor="#FF000000"
        android:pathData="M36,46 L72,46 L54,70 Z" />
    <path
        android:fillColor="#FF000000"
        android:pathData="M34,74 h40 v8 h-40 z" />
